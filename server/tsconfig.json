{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "allowJs": true,           // Allows JavaScript files to be included
        "checkJs": true,           // Enables type checking for JavaScript files
        "noEmit": true,            // Prevents TypeScript from emitting compiled files
        "types": ["node", "jest", "./types"], // Includes browser (DOM) types and your custom types
        "moduleResolution": "nodenext",  // Use Node.js module resolution
        "resolveJsonModule": true,
        "module": "nodenext",
        "target": "esnext"
    },
    "include": ["**/*.js"],        // Ensures all JavaScript files are type-checked
    "exclude": [
        "node_modules",
        "dist",
        "coverage",
        "tests"
    ]
}
