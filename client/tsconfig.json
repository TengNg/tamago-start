{
  "compilerOptions": {
    "paths": {
      "@shared/*": ["../shared/*"]
    },
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/types/**/*.d.ts",
    "src/types/*.d.ts",
    "../shared/**/*",
    "../server/types.d.ts"
  ]
}
